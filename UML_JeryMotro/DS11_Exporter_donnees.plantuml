@startuml
skinparam monochrome true

title DS11 — Exporter les données
hide footbox
skinparam shadowing false

actor "Utilisateur Premium" as U
participant "Frontend" as F
participant "Backend" as B
database "Base de données" as DB

U -> F : Ouvre l'export
F -> B : Demander les détections de la période
B -> DB : Rechercher les détections
DB --> B : Détections
B --> F : Données

alt Export CSV
    F -> F : Générer le fichier CSV
else Export JSON
    F -> F : Générer le fichier JSON
else Export PDF
    F -> F : Générer le rapport PDF
end

F --> U : Télécharger le fichier

loop Modification de la période
    U -> F : Modifier les dates
    F -> B : Demander les nouvelles données
    B -> DB : Rechercher les détections
    DB --> B : Détections
    B --> F : Données
    F -> F : Générer le fichier
    F --> U : Télécharger le fichier
end

@enduml
