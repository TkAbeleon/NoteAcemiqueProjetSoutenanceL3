@startuml

title DS11 — Exporter les données
hide footbox
skinparam shadowing false

actor "Utilisateur Premium" as U
participant "Interface Export" as I
participant "API FastAPI" as API
participant "Routeur / Service d'export" as E
participant "Base de données" as DB

U -> I : Ouvre la fonctionnalité d'export
I -> API : Demande les données exportables
API -> E : Préparer l'export
E -> DB : Rechercher les données sélectionnées
DB --> E : Données
E --> API : Résultat préparé
API --> I : Résultat de l'export
I --> U : Fournir le résultat

loop Tant que l'utilisateur modifie sa sélection
    U -> I : Modifie les critères
    I -> API : Nouvelle demande d'export
    API -> E : Préparer selon la nouvelle sélection
    E -> DB : Rechercher les données
    DB --> E : Données
    E --> API : Résultat
    API --> I : Nouvel export
    I --> U : Fournir le résultat
end

@enduml