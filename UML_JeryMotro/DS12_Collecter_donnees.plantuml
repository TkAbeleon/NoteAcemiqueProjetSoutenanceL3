@startuml
skinparam monochrome true

title DS12 — Collecter les données
hide footbox
skinparam shadowing false

participant "Planificateur (cron)" as C
participant "Backend" as B
participant "NASA FIRMS" as N
participant "Base de données" as DB

C -> B : Déclencher la collecte selon le cron
activate B
B -> N : Récupérer les données FIRMS manquantes
activate N
N --> B : Détections NASA FIRMS
deactivate N
B -> DB : Enregistrer les nouvelles détections
activate DB
DB --> B : Confirmation
deactivate DB
B --> C : Collecte terminée
deactivate B

@enduml
