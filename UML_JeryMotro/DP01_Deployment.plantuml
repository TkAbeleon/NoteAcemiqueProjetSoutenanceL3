@startuml
skinparam monochrome true
skinparam shadowing false
left to right direction
skinparam linetype ortho

node "Poste utilisateur" <<device>> as CLIENT {
    node "Navigateur Web" <<executionEnvironment>> as BROWSER
}

node "Serveur JeryMotro" <<device>> as SERVER {

    node "Nginx" <<executionEnvironment>> as NGINX {
        artifact "Frontend Web\nBuild statique" as FRONTEND
    }

    node "Services applicatifs" <<executionEnvironment>> as APPS {
        node "Backend FastAPI" <<executionEnvironment>> as BACKEND
        node "n8n" <<executionEnvironment>> as N8N
        node "WAHA" <<executionEnvironment>> as WAHA
        node "HTTPSMS / SMSGate" <<executionEnvironment>> as SMS
    }

    node "Services de données" <<executionEnvironment>> as DATA {
        node "PostgreSQL" <<executionEnvironment>> as POSTGRES
        node "Qdrant" <<executionEnvironment>> as QDRANT
    }
}

node "NASA FIRMS" as FIRMS
node "Vertex AI" as VERTEX
node "Service SMS externe" as SMS_EXT

CLIENT -- NGINX : <<HTTPS>>

NGINX -- BACKEND : <<HTTP / local>>
BACKEND -- N8N : <<HTTP / localhost>>
BACKEND -- POSTGRES : <<TCP / local>>
BACKEND -- FIRMS : <<HTTPS / API>>

N8N -- POSTGRES : <<connexion locale>>
N8N -- QDRANT : <<HTTP / localhost>>
N8N -- VERTEX : <<HTTPS / API>>
N8N -- WAHA : <<API locale>>
N8N -- SMS : <<API locale>>

SMS -- SMS_EXT : <<HTTPS / API>>

note right of SERVER
Un seul nœud matériel héberge
les services principaux de JeryMotro.
Les échanges internes restent locaux.
end note

note right of SMS
Le service SMS actif est choisi
par la configuration .env.
end note

@enduml
