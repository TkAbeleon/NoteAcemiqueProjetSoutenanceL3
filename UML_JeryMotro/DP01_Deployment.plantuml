@startuml
skinparam monochrome true
skinparam shadowing false
left to right direction
skinparam linetype ortho

node "Poste utilisateur" <<device>> as CLIENT {
    artifact "Navigateur Web" as BROWSER
}

node "Serveur JeryMotro" <<device>> as SERVER {

    node "Nginx" <<executionEnvironment>> as NGINX {
        artifact "Frontend Web\nBuild statique" as FRONTEND
    }

    node "Backend / services applicatifs" <<executionEnvironment>> as APPS {
        artifact "Backend FastAPI" as BACKEND
        artifact "n8n" as N8N
        artifact "WAHA" as WAHA
        artifact "HTTPSMS / SMSGate\nSelon .env" as SMS
    }

    node "Services de données" <<executionEnvironment>> as DATA {
        artifact "PostgreSQL" as POSTGRES
        artifact "Qdrant" as QDRANT
    }
}

node "NASA FIRMS" <<external system>> as FIRMS
node "Vertex AI" <<external system>> as VERTEX
node "Service SMS" <<external system>> as SMS_EXT

CLIENT -- SERVER : <<HTTPS>>
SERVER -- FIRMS : <<HTTPS / API>>
SERVER -- VERTEX : <<HTTPS / API>>
SERVER -- SMS_EXT : <<HTTPS / API>>

BACKEND -- N8N : <<HTTP / localhost>>
BACKEND -- WAHA : <<HTTP / localhost>>
BACKEND -- SMS : <<HTTP / localhost>>
BACKEND -- POSTGRES : <<TCP / local>>

N8N -- POSTGRES : <<connexion locale>>
N8N -- QDRANT : <<HTTP / localhost>>
N8N -- VERTEX : <<HTTPS / API>>
N8N -- WAHA : <<API locale>>
N8N -- SMS : <<API locale>>

note right of SERVER
Un seul nœud matériel héberge
les services principaux de JeryMotro.
Les services internes communiquent
localement.
end note

note bottom of SMS
Service réellement sélectionné
par la configuration .env.
end note

@enduml
