@startuml

title DS02 — S'authentifier
hide footbox
skinparam shadowing false

actor "Utilisateur" as U
participant "Frontend" as F
participant "Backend" as B
database "Base de données" as DB

U -> F : Demande l'authentification

alt E-mail et mot de passe
    U -> F : Saisit e-mail et mot de passe
    F -> B : Envoyer les identifiants
    B -> DB : Rechercher le compte
    DB --> B : Compte
    B --> F : Authentification réussie + JWT
    F --> U : Accès accordé

    alt Identifiants incorrects
        B --> F : Erreur d'authentification
        F --> U : Afficher l'erreur
        loop Nouvelle tentative
            U -> F : Ressaisir les identifiants
            F -> B : Nouvelle authentification
            B -> DB : Vérifier le compte
            DB --> B : Résultat
        end
    end
else OTP
    U -> F : Choisit OTP
    F -> B : Demander un code OTP
    B --> F : Code envoyé
    F --> U : Demander le code
    loop Jusqu'à validation
        U -> F : Saisit le code
        F -> B : Vérifier le code
        B --> F : Code valide / invalide
    end
    B --> F : Authentification réussie + JWT
    F --> U : Accès accordé
end

@enduml