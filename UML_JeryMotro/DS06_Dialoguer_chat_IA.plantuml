@startuml

title DS06 — Dialoguer avec le Chat IA
hide footbox
skinparam shadowing false

actor "Utilisateur" as U
participant "Frontend" as F
participant "Backend (proxy)" as B
participant "n8n — Gestion du Chat IA" as N8N

loop Tant que l'utilisateur poursuit la conversation
    U -> F : Saisir une question
    F -> B : Envoyer la demande
    B -> N8N : Relayer la demande
    N8N --> B : Réponse du Chat IA
    B --> F : Relayer la réponse
    F --> U : Afficher la réponse
end

@enduml
