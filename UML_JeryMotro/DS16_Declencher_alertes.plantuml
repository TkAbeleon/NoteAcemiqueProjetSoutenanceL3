@startuml

title DS16 — Déclencher les alertes
hide footbox
skinparam shadowing false

actor "Administrateur" as A
participant "Frontend" as F
participant "Backend" as B
database "Base de données" as DB
participant "Services de notification" as N

A -> F : Lance le déclenchement
F -> B : Demander les alertes
B -> DB : Rechercher les abonnements éligibles
DB --> B : Abonnements
B -> N : Envoyer les notifications
N --> B : Résultats des envois
B -> DB : Enregistrer les alertes
DB --> B : Confirmation
B --> F : Résultat
F --> A : Afficher le résultat

@enduml