@startuml
skinparam monochrome true
left to right direction

title Diagramme de cas d'utilisation — Système JeryMotro

skinparam shadowing false
skinparam actorStyle awesome
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 75

' =========================================================
' ACTEURS
' =========================================================

actor "Visiteur" as VIS
actor "Utilisateur Standard" as STD
actor "Utilisateur Premium" as PRE
actor "Administrateur" as ADM

' Hiérarchie des rôles
STD -|> VIS
PRE -|> STD
ADM -|> PRE

' =========================================================
' SYSTÈME JERYMOTRO
' =========================================================

rectangle "Système JeryMotro" {

    usecase "Créer un compte" as UC01
    usecase "S'authentifier" as UC02

    usecase "Consulter la carte des feux" as UC03
    usecase "Consulter les feux actifs" as UC04
    usecase "Consulter les statistiques" as UC05

    usecase "Dialoguer avec le Chat IA" as UC06

    usecase "Gérer les alertes" as UC07
    usecase "Recevoir les alertes e-mail" as UC08
    usecase "Recevoir les alertes SMS et WhatsApp" as UC09

    usecase "Définir une zone prioritaire" as UC10
    usecase "Exporter les données" as UC11

    usecase "Collecter les données" as UC12
    usecase "Générer les prédictions de risque" as UC13
    usecase "Regrouper les détections" as UC14
    usecase "Mettre à jour le statut des feux" as UC15
    usecase "Déclencher les alertes" as UC16
}

' =========================================================
' VISITEUR
' =========================================================

VIS --> UC01
VIS --> UC03
VIS --> UC04

' =========================================================
' UTILISATEUR STANDARD
' =========================================================

STD --> UC02
STD --> UC05
STD --> UC06
STD --> UC07
STD --> UC08

' =========================================================
' UTILISATEUR PREMIUM
' =========================================================

PRE --> UC10
PRE --> UC11
PRE --> UC09

' =========================================================
' ADMINISTRATEUR
' =========================================================

ADM --> UC12
ADM --> UC13
ADM --> UC14
ADM --> UC15
ADM --> UC16

' =========================================================
' AUTHENTIFICATION
' =========================================================

UC05 ..> UC02 : <<include>>
UC06 ..> UC02 : <<include>>
UC07 ..> UC02 : <<include>>
UC08 ..> UC02 : <<include>>
UC09 ..> UC02 : <<include>>
UC10 ..> UC02 : <<include>>
UC11 ..> UC02 : <<include>>

' Configuration préalable des alertes
UC08 ..> UC07 : <<include>>
UC09 ..> UC07 : <<include>>

@enduml
