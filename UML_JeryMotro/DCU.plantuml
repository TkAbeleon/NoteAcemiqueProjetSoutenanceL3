@startuml
left to right direction

skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam linetype ortho
skinparam nodesep 25
skinparam ranksep 55
skinparam packagePadding 18

' ==================================================
' ACTEURS HUMAINS — côté gauche
' ==================================================

together {
    actor "Visiteur" as Visiteur
    actor "Utilisateur Standard" as Standard
    actor "Utilisateur Premium" as Premium
}

' Héritage vertical des profils
Visiteur -[hidden]down-> Standard
Standard -[hidden]down-> Premium

' ==================================================
' ACTEURS / SERVICES EXTERNES — côté droit
' ==================================================

together {
    actor "NASA FIRMS" as FIRMS
    actor "Service ML externe" as ML
    actor "n8n" as N8N
    actor "Base de connaissances Qdrant" as Qdrant
    actor "Base de données PostgreSQL" as PSQL
    actor "WAHA" as WAHA
    actor "Service SMS" as SMS
}

' ==================================================
' SYSTÈME JERYMOTRO
' ==================================================

rectangle "Système JeryMotro" {

    package "Accès public" {
        usecase "Consulter carte de feux" as UC1
        usecase "Voir les feux actifs" as UC2
        usecase "Créer compte" as UC3
    }

    package "Authentification" {
        usecase "S'authentifier" as UC4
    }

    package "Services utilisateur" {
        usecase "Consulter statistiques" as UC5
        usecase "Dialoguer avec le Chat IA" as UC6
        usecase "Recevoir alertes e-mail" as UC7
        usecase "Définir zone prioritaire" as UC8
        usecase "Recevoir alertes SMS et WhatsApp" as UC9
        usecase "Gérer les alertes" as UC10
    }

    package "Traitements automatiques" {
        usecase "Collecter automatiquement les données FIRMS" as UC11
        usecase "Générer les prédictions de risque" as UC12
        usecase "Mettre à jour le statut des feux" as UC13
        usecase "Déclencher les alertes" as UC14
    }

    package "Traitement du Chat IA" {
        usecase "Identifier le type de question" as UC15
        usecase "Interroger la base de données" as UC16
        usecase "Interroger la base de connaissances" as UC17
        usecase "Combiner les résultats des sources" as UC18
    }
}

' ==================================================
' ACTEURS HUMAINS
' ==================================================

Visiteur -right-> UC1
Visiteur -right-> UC2
Visiteur -right-> UC3

Standard -right-> UC4
Standard -right-> UC5
Standard -right-> UC6
Standard -right-> UC7
Standard -right-> UC10

Premium -right-> UC8
Premium -right-> UC9

' Héritage : Premium -> Standard -> Visiteur
Standard -up-|> Visiteur
Premium -up-|> Standard

' ==================================================
' AUTHENTIFICATION OBLIGATOIRE
' ==================================================

UC5 ..> UC4 : <<include>>
UC6 ..> UC4 : <<include>>
UC7 ..> UC4 : <<include>>
UC8 ..> UC4 : <<include>>
UC9 ..> UC4 : <<include>>
UC10 ..> UC4 : <<include>>

' ==================================================
' BASE DE DONNÉES POSTGRESQL
' ==================================================

UC1 -right-> PSQL
UC2 -right-> PSQL
UC3 -right-> PSQL
UC4 -right-> PSQL
UC5 -right-> PSQL
UC6 -right-> PSQL
UC8 -right-> PSQL
UC10 -right-> PSQL
UC11 -right-> PSQL
UC12 -right-> PSQL
UC13 -right-> PSQL
UC14 -right-> PSQL
UC16 -right-> PSQL
UC18 -right-> PSQL

' ==================================================
' COLLECTE FIRMS ET PRÉDICTIONS ML
' ==================================================

UC11 -right-> FIRMS
UC12 -right-> ML

' ==================================================
' CHAT IA / n8n
' ==================================================

UC6 ..> UC15 : <<include>>
UC15 ..> UC16 : <<include>>
UC15 ..> UC17 : <<include>>
UC15 ..> UC18 : <<extend>>

UC6 -right-> N8N
UC15 -right-> N8N
UC16 -right-> N8N
UC17 -right-> N8N
UC18 -right-> N8N
UC17 -right-> Qdrant
UC18 -right-> Qdrant

' ==================================================
' NOTIFICATIONS
' ==================================================

UC7 -right-> N8N
UC9 -right-> WAHA
UC9 -right-> SMS

' ==================================================
' TRAITEMENTS AUTOMATIQUES DES ALERTES
' ==================================================

UC11 ..> UC13 : <<include>>
UC12 ..> UC13 : <<include>>
UC13 ..> UC14 : <<include>>
UC14 -right-> PSQL

@enduml
