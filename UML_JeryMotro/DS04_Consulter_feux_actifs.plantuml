@startuml

title DS04 — Consulter les feux actifs
hide footbox
skinparam shadowing false

actor "Visiteur" as V
participant "Frontend" as F
participant "Backend" as B
database "Base de données" as DB

V -> F : Demande les feux actifs
F -> B : Rechercher les feux actifs
B -> DB : Lire les événements actifs
DB --> B : Feux actifs
B --> F : Résultats
F --> V : Afficher les feux actifs

loop Actualisation de la consultation
    V -> F : Actualiser
    F -> B : Nouvelle demande
    B -> DB : Rechercher les feux actifs
    DB --> B : Résultats
    B --> F : Mise à jour
    F --> V : Afficher les résultats
end

@enduml