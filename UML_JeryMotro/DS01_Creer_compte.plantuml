@startuml
skinparam monochrome true

title DS01 — Créer un compte
hide footbox
skinparam shadowing false

actor "Visiteur" as V
participant "Frontend" as F
participant "Backend" as B
participant "Base de données" as DB

activate V
V -> F : Remplit le formulaire d'inscription
activate F
F -> B : Envoyer les données
activate B
B -> DB : Vérifier l'e-mail
activate DB
DB --> B : E-mail disponible ?
deactivate DB

alt E-mail déjà utilisé
    B --> F : Inscription refusée
    deactivate B
    F --> V : Afficher l'erreur
    deactivate F
    loop Jusqu'à correction
        V -> F : Corriger les informations
        activate F
        F -> B : Renvoyer le formulaire
        activate B
        B -> DB : Vérifier l'e-mail
        activate DB
        DB --> B : Résultat
        deactivate DB
    end
else E-mail disponible
    B -> DB : Créer le compte
    activate DB
    DB --> B : Compte créé
    deactivate DB
    B --> F : Confirmation + JWT
    deactivate B
    F --> V : Compte créé
    deactivate F
end

@enduml
