@startuml

title DS09 — Recevoir les alertes SMS et WhatsApp
hide footbox
skinparam shadowing false

actor "Utilisateur Premium" as U
participant "Backend" as B
database "Base de données" as DB
participant "Service de notification" as N

B -> DB : Rechercher les abonnements actifs
DB --> B : Abonnements vérifiés
B -> N : Envoyer l'alerte

alt SMS
    N --> U : Notification SMS
else WhatsApp
    N --> U : Notification WhatsApp
end

B -> DB : Enregistrer l'alerte
DB --> B : Confirmation

@enduml