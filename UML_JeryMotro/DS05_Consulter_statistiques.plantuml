@startuml

title DS05 — Consulter les statistiques
hide footbox
skinparam shadowing false

actor "Utilisateur Standard" as U
participant "Frontend" as F
participant "Backend" as B
database "Base de données" as DB

U -> F : Ouvre les statistiques
F -> B : Demander les statistiques
B -> DB : Calculer les statistiques
DB --> B : Résultats
B --> F : Données statistiques
F --> U : Afficher les indicateurs

loop Modification de la période
    U -> F : Changer la période
    F -> B : Nouvelle demande
    B -> DB : Recalculer les statistiques
    DB --> B : Résultats
    B --> F : Mise à jour
    F --> U : Afficher les indicateurs
end

@enduml