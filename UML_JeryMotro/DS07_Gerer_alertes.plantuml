@startuml
skinparam monochrome true

title DS07 — Gérer les alertes
hide footbox
skinparam shadowing false

actor "Utilisateur" as U
participant "Frontend" as F
participant "Backend" as B
participant "Base de données" as DB

U -> F : Configurer une alerte
F -> B : Enregistrer la configuration

alt SMS / WhatsApp pour Standard
    B --> F : Accès refusé
else Configuration acceptée
    B -> DB : Créer / modifier l'abonnement

    alt Nouveau canal ou destination
        B -> B : Générer un OTP
        B --> F : Demander la vérification
        U -> F : Saisir le code OTP
        F -> B : Vérifier le code
        alt Code valide
            B -> DB : Valider l'abonnement
        else Code incorrect / expiré
            B --> F : Vérification refusée
        end
    else Destination existante
        B --> F : Configuration enregistrée
    end
end

opt Gestion ultérieure
    alt Renvoyer OTP
        U -> F : Demander un nouveau code
        F -> B : Renvoyer le code
    else Modifier les seuils
        U -> F : Modifier les seuils
        F -> B : Enregistrer
        B -> DB : Mettre à jour
    else Supprimer
        U -> F : Supprimer l'abonnement
        F -> B : Supprimer
        B -> DB : Supprimer
    end
end

@enduml
