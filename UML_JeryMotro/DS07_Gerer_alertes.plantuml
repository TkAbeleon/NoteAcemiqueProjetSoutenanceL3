@startuml

title DS07 — Gérer les alertes
hide footbox
skinparam shadowing false

actor "Utilisateur" as U
participant "Frontend" as F
participant "Backend" as B
database "Base de données" as DB

U -> F : Ouvre les alertes
F -> B : Consulter les abonnements
B -> DB : Lire les abonnements
DB --> B : Abonnements
B --> F : Configuration actuelle
F --> U : Afficher les paramètres

U -> F : Configure une alerte
F -> B : Enregistrer la configuration
B -> DB : Créer / modifier l'abonnement
DB --> B : Confirmation
B --> F : Configuration enregistrée
F --> U : Confirmer

loop Si la vérification est demandée
    U -> F : Saisit le code de vérification
    F -> B : Vérifier le code
    B -> DB : Contrôler l'abonnement
    DB --> B : Résultat
    B --> F : Valide / invalide
end

@enduml