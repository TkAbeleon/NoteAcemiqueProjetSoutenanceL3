@startuml

title DS07 — Gérer les alertes
hide footbox
skinparam shadowing false

actor "Utilisateur" as U
participant "Frontend" as F
participant "Backend" as B
participant "Base de données" as DB

U -> F : Ouvre la gestion des alertes
F -> B : Consulter les abonnements
B -> DB : Rechercher les abonnements
DB --> B : Abonnements
B --> F : Configuration actuelle
F --> U : Afficher les paramètres

U -> F : Choisir un canal

alt E-mail
    U -> F : Saisir l'adresse e-mail
else SMS
    U -> F : Saisir le numéro de téléphone
else WhatsApp
    U -> F : Saisir le numéro WhatsApp
end

U -> F : Définir les seuils de risque et de FRP
F -> B : Créer / modifier l'abonnement

alt SMS ou WhatsApp pour un compte Standard
    B --> F : Accès refusé
    F --> U : Canal réservé au Premium/Admin
else Nouveau canal ou nouvelle destination
    B -> DB : Enregistrer l'abonnement non vérifié
    DB --> B : Abonnement enregistré
    B -> B : Générer un code OTP
    B -> DB : Enregistrer le code et l'expiration
    DB --> B : Confirmation
    B --> F : Demander la vérification
    F --> U : Saisir le code OTP

    loop Jusqu'à validation du code
        U -> F : Saisir le code OTP
        F -> B : Vérifier le code
        B -> DB : Contrôler le code et l'expiration
        DB --> B : Résultat

        alt Code valide
            B -> DB : Marquer l'abonnement comme vérifié
            DB --> B : Confirmation
            B --> F : Abonnement vérifié
            F --> U : Configuration validée
        else Code incorrect ou expiré
            B --> F : Vérification refusée
            F --> U : Afficher l'erreur
        end
    end
else Même destination
    B -> DB : Mettre à jour les seuils et activer l'abonnement
    DB --> B : Confirmation
    B --> F : Configuration enregistrée
    F --> U : Afficher la confirmation
end

loop Gestion ultérieure
    alt Renvoyer le code
        U -> F : Demander un nouveau code
        F -> B : Renvoyer le code OTP
        B -> DB : Enregistrer le nouveau code et l'expiration
        DB --> B : Confirmation
        B --> F : Nouveau code envoyé
    else Supprimer un abonnement
        U -> F : Supprimer l'abonnement
        F -> B : Supprimer l'abonnement
        B -> DB : Supprimer l'abonnement
        DB --> B : Confirmation
        B --> F : Suppression confirmée
        F --> U : Abonnement supprimé
    end
end

@enduml
