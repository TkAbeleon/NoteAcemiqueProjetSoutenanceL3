@startuml

title DS03 — Consulter la carte des feux
hide footbox
skinparam shadowing false

actor "Visiteur" as V
participant "Frontend" as F
participant "Backend" as B
database "Base de données" as DB

V -> F : Ouvre la carte
F -> B : Demander les détections
B -> DB : Rechercher les détections
DB --> B : Détections
B --> F : Résultats
F --> V : Afficher la carte

loop Modification des critères
    V -> F : Modifier période, risque, région ou source
    F -> B : Nouvelle demande
    B -> DB : Rechercher selon les critères
    DB --> B : Résultats
    B --> F : Détections filtrées
    F --> V : Actualiser la carte
end

@enduml